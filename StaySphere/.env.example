# Development-only values. Copy to .env (git-ignored). Never use these anywhere real.
SQL_SA_PASSWORD=StaySphere_Dev_P@ssw0rd
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
QUOTE_SIGNING_KEY=dev-only-quote-key-change-me-0123456789abcdef
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret
# Mock = offline stubs; Live = OpenStreetMap Nominatim, Open-Meteo, Frankfurter (free, rate limited)
EXTERNAL_SERVICES_MODE=Mock
# AI assistant (Microsoft Agent Framework agent). Providers:
#   Gemini (default)  -> set GEMINI_API_KEY (free key: https://aistudio.google.com/apikey)
#   FoundryLocal      -> AI_BASE_URL=http://host.docker.internal:<port>/v1 (see `foundry service status`), AI_MODEL=<model id>
#   Ollama            -> AI_BASE_URL=http://ollama:11434 AI_MODEL=llama3.2 (docker compose --profile ai up)
#   OpenAI            -> AI_API_KEY=..., AI_MODEL=..., optional AI_BASE_URL for Azure OpenAI / other compatible servers
#   Rules             -> offline rule-based assistant (also the automatic fallback)
# Real keys belong in .env only (git-ignored), never in appsettings or source control.
AI_PROVIDER=Gemini
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
GEMINI_API_KEY=

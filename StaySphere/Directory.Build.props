<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873 (LoggerMessage delegates) and CA2007 (ConfigureAwait) are noise for an ASP.NET Core app -->
    <NoWarn>$(NoWarn);CA1000;CA2225;CA1024;CA1720;CA1725;CA1052;CA1848;CA1873;CA2007;CA1716;CA1711;CA1062;CA1515;CA1031;CA2227;CA1056;CA1054;CA1055;CA1819;CA1308;CA1304;CA1305;CA1311;CA1307;CA1309;CA1310;CA5394;CA1002;CA1724;CA1034;CA1032;CA1822;CA1859;CA1861;CA1812;CA2000;CA1805;CA1707;CA1863;CA1869;CA1866;CA1865;CA1862;CA2234;CA1508;CA1303;CA1001;CA1063;CA1816</NoWarn>
  </PropertyGroup>
</Project>

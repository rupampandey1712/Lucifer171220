{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sql": "",
    "Redis": ""
  },
  "App": {
    "PublicWebUrl": "http://localhost:5173",
    "RefreshTokenDays": 14
  },
  "Jwt": {
    "Issuer": "staysphere",
    "Audience": "staysphere-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Quotes": { "SigningKey": "" },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "Database": { "MigrateOnStartup": false, "Seed": false },
  "Storage": { "Provider": "Local", "LocalPath": ".data/media", "LocalPublicBaseUrl": "/media" },
  "Email": { "Provider": "Log", "FromAddress": "no-reply@staysphere.local", "FromName": "StaySphere" },
  "Payments": { "Fake": { "WebhookSecret": "", "WebhookUrl": "", "DelayedWebhookSeconds": 5 } },
  "Messaging": { "Transport": "InMemory", "TopicName": "staysphere.events", "SubscriptionName": "staysphere-workers" },
  "Workers": { "Outbox": true, "Consumers": true, "Jobs": true },
  "ExternalServices": {
    "Mode": "Mock",
    "DefaultTaxPercent": 10,
    "TaxRates": { "GB": 0, "US": 12, "FR": 5.5, "PT": 6, "ES": 10, "IT": 10, "NL": 12.5, "IN": 12, "JP": 10, "AU": 10, "GR": 13, "CH": 3.8 }
  },
  "AI": { "Provider": "Rules", "BaseUrl": "http://localhost:11434", "Model": "", "MaxTurns": 20, "TimeoutSeconds": 60 },
  "FeatureManagement": {
    "AiAssistant": true,
    "NewSearch": true,
    "DynamicPricing": false,
    "Experiences": false
  },
  "Swagger": { "Enabled": false },
  "RateLimiting": { "Multiplier": 1 }
}

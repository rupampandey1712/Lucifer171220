{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deps: start",
      "type": "shell",
      "command": "docker compose up -d sqlserver redis azurite mailpit aspire-dashboard",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build: api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/StaySphere.Api/StaySphere.Api.csproj", "-c", "Debug"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web/staysphere-web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    }
  ]
}
